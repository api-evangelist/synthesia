{
  "opencollection": "1.0.0",
  "info": {
    "name": "Synthesia Assets API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create media asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.synthesia.io/v2/assets"
          },
          "docs": "Create media asset"
        },
        {
          "info": {
            "name": "Get user media asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.synthesia.io/v2/assets/:assetId",
            "params": [
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get user media asset"
        },
        {
          "info": {
            "name": "Upload script audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.synthesia.io/v2/assets/script-audio"
          },
          "docs": "Upload script audio"
        }
      ]
    }
  ],
  "bundled": true
}